# Add these in Vercel: Project > Settings > Environment Variables, then redeploy.

# --- Storage (added automatically when you connect "Upstash for Redis" in the Storage tab) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- AI model (any OpenAI-compatible API) ---
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# Leave empty for OpenAI. Gemini: https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=make-up-a-password
WHATSAPP_APP_SECRET=
# The number patients message, digits only with country code. Used by every QR code and button.
WHATSAPP_DISPLAY_NUMBER=

# Optional: approved templates for messages outside WhatsApp's 24-hour window
WHATSAPP_CONFIRM_TEMPLATE=
WHATSAPP_DOCTOR_ALERT_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Optional
ORG_NAME=
ASSISTANT_NAME=Asha
ENABLE_WEB_CHAT=true
WHATSAPP_API_BASE=
WHATSAPP_GRAPH_VERSION=v24.0
